{
  "expo": {
    "name": "Cleanse",
    "slug": "cleanse",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cleanse",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.arcane-flame.cleanse",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Cleanse needs access to your photo library to scan and archive unwanted media.",
        "NSPhotoLibraryAddUsageDescription": "Cleanse needs permission to save restored photos back to your library."
      }
    },
    "android": {
      "package": "com.arcanflame.cleanse",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-media-library",
      "expo-secure-store",
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
